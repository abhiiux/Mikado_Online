.screen { position:absolute; left:0; right:0; top:0; bottom:0; }.settings-button { position:absolute; left:34px; top:34px; width:66px; height:66px; font-size:38px; background-color:rgb(245,245,245); color:black; }.counter-card { position:absolute; left:267px; top:160px; width:400px; height:400px; align-items:center; justify-content:space-between; background-color:rgba(235,245,245,0.72); }.arrow-button { width:67px; height:67px; font-size:28px; color:white; background-color:rgb(0,151,213); }.counter-value { font-size:46px; color:black; }.menu-buttons { position:absolute; right:0; top:230px; width:370px; }.menu-button { height:80px; margin-bottom:32px; font-size:46px; -unity-text-align:middle-left; padding-left:18px; color:black; background-color:rgb(238,242,242); border-left-width:8px; border-left-color:rgba(40,80,80,0.35); }.settings-panel { display:none; position:absolute; left:320px; right:320px; top:72px; bottom:72px; padding:28px; background-color:rgba(235,245,245,0.98); color:black; }.title { font-size:34px; -unity-font-style:bold; margin-bottom:20px; }.unity-toggle { font-size:20px; margin-bottom:16px; }.setting-row { flex-direction:row; align-items:center; margin-bottom:16px; }.setting-row .unity-base-slider { flex-grow:1; }.setting-row > .unity-label { width:55px; }.footer { flex-direction:row; justify-content:flex-end; margin-top:auto; }.footer .unity-button { width:110px; height:44px; margin-left:12px; font-size:20px; }